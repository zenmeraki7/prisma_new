generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shop state tracking
model ShopState {
  shopId         String    @id
  fastReady      Boolean   @default(false)
  fastLastSyncAt DateTime?
  fastRevision   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Main FAST-plane product table
model ProductLite {
  shopId             String
  title              String
  handle             String
  status             String
  vendor             String?
  productType        String?
  tags               String[]                   @default([])
  hasImages          Boolean                    @default(false)
  createdAtShopify   DateTime?
  updatedAtShopify   DateTime?
  publishedAtShopify DateTime?
  updatedAt          DateTime                   @default(now()) @updatedAt
  id                 String                     @id
  collections        ProductCollection[]
  inventoryByLoc     ProductInventoryLocation[]
  optionValues       ProductOptionValue[]
  tagsJoin           ProductTag[]
  variants           VariantLite[]
  variantRollup      VariantRollup?

  @@unique([shopId, id])
  @@index([shopId, updatedAtShopify(sort: Desc)])
  @@index([shopId, title])
}

/// Rollup per product for fast filters
model VariantRollup {
  shopId               String
  productId            String
  variantCount         Int         @default(0)
  totalInventory       Int         @default(0)
  minPrice             Decimal?    @db.Decimal(18, 6)
  maxPrice             Decimal?    @db.Decimal(18, 6)
  hasOutOfStockVariant Boolean     @default(false)
  hasInStockVariant    Boolean     @default(false)
  updatedAt            DateTime    @default(now()) @updatedAt
  product              ProductLite @relation(fields: [shopId, productId], references: [shopId, id])

  @@id([shopId, productId])
  @@index([shopId, totalInventory])
  @@index([shopId, minPrice])
  @@index([shopId, maxPrice])
}

/// Job ledger for background jobs
model JobLedger {
  id         String    @id @default(cuid())
  shopId     String
  type       JobType
  status     JobStatus @default(PENDING)
  queueJobId String?
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shopId, type, status])
  @@index([shopId, createdAt])
}

/// Optional relational tags table
model ProductTag {
  id        BigInt      @id @default(autoincrement())
  shopId    String
  productId String
  tag       String
  product   ProductLite @relation(fields: [shopId, productId], references: [shopId, id])

  @@unique([shopId, productId, tag])
  @@index([shopId, tag, productId])
}

/// Collections mapping table
model ProductCollection {
  id               BigInt      @id @default(autoincrement())
  shopId           String
  productId        String
  collectionId     String
  collectionHandle String?
  collectionTitle  String?
  product          ProductLite @relation(fields: [shopId, productId], references: [shopId, id])

  @@unique([shopId, productId, collectionId])
  @@index([shopId, collectionId, productId])
}

/// Per-variant FAST table
model VariantLite {
  id              BigInt      @id @default(autoincrement())
  shopId          String
  variantId       String
  productId       String
  sku             String?
  barcode         String?
  price           Decimal     @db.Decimal(18, 6)
  compareAtPrice  Decimal?
  cost            Decimal?
  taxable         Boolean?
  trackQuantity   Boolean?
  inventoryQty    Int
  inventoryPolicy String?
  weightGrams     Int?
  weightUnit      String?
  option1Value    String?
  option2Value    String?
  option3Value    String?
  product         ProductLite @relation(fields: [shopId, productId], references: [shopId, id])

  @@unique([shopId, variantId])
  @@index([shopId, productId])
  @@index([shopId, sku])
  @@index([shopId, barcode])
  @@index([shopId, price])
}

/// Product option values (1,2,3)
model ProductOptionValue {
  id          BigInt      @id @default(autoincrement())
  shopId      String
  productId   String
  optionIndex Int
  value       String
  product     ProductLite @relation(fields: [shopId, productId], references: [shopId, id])

  @@unique([shopId, productId, optionIndex, value])
  @@index([shopId, optionIndex, value, productId])
}

/// Inventory per location
model ProductInventoryLocation {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  productId     String
  locationId    String
  hasInventory  Boolean     @default(false)
  totalQuantity Int?
  product       ProductLite @relation(fields: [shopId, productId], references: [shopId, id])

  @@unique([shopId, productId, locationId])
  @@index([shopId, locationId, productId])
}

enum JobType {
  FAST_FULL_SYNC
  FAST_DELTA_REFRESH
  SNAPSHOT_RUN
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}
