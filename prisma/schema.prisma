generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProductLite {
  id                String
  shopId            String
  title             String
  handle            String
  status            String
  vendor            String?
  productType       String?
  hasImages         Boolean             @default(false)
  updatedAtShopify  DateTime?
  ProductCollection ProductCollection[]
  Shop              Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ProductTag        ProductTag[]
  VariantRollup     VariantRollup?

  @@id([shopId, id])
  @@index([shopId, updatedAtShopify])
  @@index([shopId, productType])
  @@index([shopId, status])
  @@index([shopId, vendor])
}

model VariantRollup {
  shopId         String
  productId      String
  totalInventory Int?
  minPrice       Decimal?    @db.Decimal(18, 2)
  maxPrice       Decimal?    @db.Decimal(18, 2)
  ProductLite    ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, productId])
  @@index([shopId, totalInventory])
}

model SnapshotRun {
  id            String             @id @default(cuid())
  shopId        String
  planHash      String
  state         SnapshotState      @default(PENDING)
  progress      Int                @default(0)
  total         Int                @default(0)
  errorMessage  String?
  filterSummary String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  expiresAt     DateTime?
  products      SnapshotProduct[]
  Shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events        SnapshotRunEvent[]

  @@index([shopId, planHash])
  @@index([shopId, createdAt])
  @@index([expiresAt])
  @@index([state])
}

model SnapshotProduct {
  snapshotRunId String
  shopId        String
  productId     String
  sortKey       DateTime?
  Shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  snapshotRun   SnapshotRun @relation(fields: [snapshotRunId], references: [id], onDelete: Cascade)

  @@id([snapshotRunId, productId])
  @@index([shopId, productId])
}

model SnapshotRunEvent {
  id            String               @id @default(cuid())
  snapshotRunId String
  shopId        String
  kind          SnapshotRunEventKind @default(INFO)
  message       String?
  createdAt     DateTime             @default(now())
  Shop          Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  snapshotRun   SnapshotRun          @relation(fields: [snapshotRunId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([snapshotRunId, createdAt])
}

model BulkOpsJob {
  id              String            @id
  shopId          String
  scopeType       String
  scopeRef        String
  actionKind      String
  actionPayload   Json
  state           BulkJobState      @default(PENDING)
  total           Int               @default(0)
  processed       Int               @default(0)
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  Shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  BulkOpsJobEvent BulkOpsJobEvent[]

  @@index([shopId, createdAt])
  @@index([shopId, state])
}

model BulkOpsJobEvent {
  id         String     @id
  jobId      String
  shopId     String
  kind       String
  message    String?
  createdAt  DateTime   @default(now())
  BulkOpsJob BulkOpsJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  Shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([shopId, createdAt])
}

model FastSyncState {
  shopId         String    @id
  fastReady      Boolean   @default(false)
  fastLastSyncAt DateTime?
  fastRevision   Int       @default(0)
  syncEnqueued   Boolean   @default(false)
  Shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model IdempotencyLedger {
  id        String   @id
  shopId    String
  scope     String
  key       String
  createdAt DateTime @default(now())
  Shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, scope, key])
}

model ProductCollection {
  shopId       String
  productId    String
  collectionId String
  ProductLite  ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, productId, collectionId])
  @@index([shopId, collectionId])
}

model ProductTag {
  shopId      String
  productId   String
  tag         String
  ProductLite ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, productId, tag])
  @@index([shopId, tag])
}

model Shop {
  id                String              @id
  shopDomain        String              @unique
  accessToken       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  BulkOpsJob        BulkOpsJob[]
  BulkOpsJobEvent   BulkOpsJobEvent[]
  FastSyncState     FastSyncState?
  IdempotencyLedger IdempotencyLedger[]
  ProductLite       ProductLite[]
  SnapshotProduct   SnapshotProduct[]
  SnapshotRun       SnapshotRun[]
  SnapshotRunEvent  SnapshotRunEvent[]
}

enum BulkJobState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SnapshotRunEventKind {
  INFO
  WARNING
  ERROR
}

enum SnapshotState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
}
