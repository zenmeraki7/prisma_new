generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShopState {
  shopId         String   @id
  fastReady      Boolean  @default(false)
  fastLastSyncAt DateTime?
  fastRevision   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/**
 * Product-first FAST table.
 * One row per Shopify product per shop.
 */
model ProductLite {
  shopId                   String
  id                       String

  title                    String
  handle                   String
  status                   String

  vendor                   String?
  productType              String?
  categoryId               String?
  categoryName             String?

  description              String?
  templateSuffix           String?

  seoHidden                Boolean                    @default(false)
  visibleOnlineStore       Boolean                    @default(false)
  visiblePos               Boolean                    @default(false)

  option1Name              String?
  option2Name              String?
  option3Name              String?

  tags                     String[]                   @default([])
  hasImages                Boolean                    @default(false)

  createdAtShopify         DateTime?
  updatedAtShopify         DateTime?
  publishedAtShopify       DateTime?

  updatedAt                DateTime                   @default(now()) @updatedAt

  collections              ProductCollection[]
  inventoryByLoc           ProductInventoryLocation[]
  optionValues             ProductOptionValue[]
  tagsJoin                 ProductTag[]
  variants                 VariantLite[]
  variantRollup            VariantRollup?

  @@id([shopId, id])
  @@index([shopId, updatedAtShopify(sort: Desc)])
  @@index([shopId, title])
  @@index([shopId, handle])
  @@index([shopId, status])
  @@index([shopId, vendor])
  @@index([shopId, productType])
  @@index([shopId, categoryName])
  @@index([shopId, visibleOnlineStore])
  @@index([shopId, visiblePos])
  @@index([shopId, seoHidden])
  @@index([shopId, templateSuffix])
}

/**
 * Rollup per product for fast product-level filters.
 */
model VariantRollup {
  shopId                   String
  productId                String

  variantCount             Int         @default(0)
  totalInventory           Int         @default(0)

  minPrice                 Decimal?    @db.Decimal(18, 6)
  maxPrice                 Decimal?    @db.Decimal(18, 6)

  minCompareAtPrice        Decimal?    @db.Decimal(18, 6)
  maxCompareAtPrice        Decimal?    @db.Decimal(18, 6)

  minCost                  Decimal?    @db.Decimal(18, 6)
  maxCost                  Decimal?    @db.Decimal(18, 6)

  hasOutOfStockVariant     Boolean     @default(false)
  hasInStockVariant        Boolean     @default(false)

  updatedAt                DateTime    @default(now()) @updatedAt

  product                  ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@id([shopId, productId])
  @@index([shopId, totalInventory])
  @@index([shopId, variantCount])
  @@index([shopId, minPrice])
  @@index([shopId, maxPrice])
}

/**
 * Job ledger
 */
model JobLedger {
  id         String    @id @default(cuid())
  shopId     String
  type       JobType
  status     JobStatus @default(PENDING)
  queueJobId String?
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shopId, type, status])
  @@index([shopId, createdAt])
}

model ProductTag {
  id        BigInt      @id @default(autoincrement())
  shopId    String
  productId String
  tag       String
  product   ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, productId, tag])
  @@index([shopId, tag, productId])
}

model ProductCollection {
  id               BigInt      @id @default(autoincrement())
  shopId           String
  productId        String
  collectionId     String
  collectionHandle String?
  collectionTitle  String?
  product          ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, productId, collectionId])
  @@index([shopId, collectionId, productId])
  @@index([shopId, collectionHandle, productId])
  @@index([shopId, collectionTitle, productId])
}

/**
 * Variant-first FAST table.
 * One row per Shopify variant per shop.
 */
model VariantLite {
  id                    BigInt      @id @default(autoincrement())
  shopId                String
  variantId             String
  productId             String

  title                 String?

  sku                   String?
  barcode               String?

  price                 Decimal?    @db.Decimal(18, 6)
  compareAtPrice        Decimal?    @db.Decimal(18, 6)
  cost                  Decimal?    @db.Decimal(18, 6)

  /**
   * Materialized for fast filtering/sorting.
   * You can also recompute from price/cost during sync.
   * Example: ((price - cost) / NULLIF(price, 0)) * 100
   */
  profitMarginPct       Decimal?    @db.Decimal(9, 4)

  taxable               Boolean?
  trackQuantity         Boolean?
  requiresShipping      Boolean?

  inventoryQty          Int         @default(0)
  inventoryPolicy       String?

  countryOfOrigin       String?
  hsTariffCode          String?

  weightGrams           Int?
  weightUnit            String?

  option1Value          String?
  option2Value          String?
  option3Value          String?

  product               ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, variantId])
  @@index([shopId, productId])
  @@index([shopId, sku])
  @@index([shopId, barcode])
  @@index([shopId, title])
  @@index([shopId, price])
  @@index([shopId, compareAtPrice])
  @@index([shopId, cost])
  @@index([shopId, profitMarginPct])
  @@index([shopId, inventoryQty])
  @@index([shopId, inventoryPolicy])
  @@index([shopId, trackQuantity])
  @@index([shopId, taxable])
  @@index([shopId, requiresShipping])
  @@index([shopId, countryOfOrigin])
  @@index([shopId, hsTariffCode])
  @@index([shopId, weightUnit])
}

/**
 * Optional helper table if you want product option values independent of variants.
 */
model ProductOptionValue {
  id          BigInt      @id @default(autoincrement())
  shopId      String
  productId   String
  optionIndex Int
  value       String
  product     ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, productId, optionIndex, value])
  @@index([shopId, optionIndex, value, productId])
}

/**
 * Inventory/location linkage for product-level location filters.
 * Add locationName so UI suggestions/filtering need not depend on external joins.
 */
model ProductInventoryLocation {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  productId     String
  locationId    String
  locationName  String?
  hasInventory  Boolean     @default(false)
  totalQuantity Int?
  product       ProductLite @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, productId, locationId])
  @@index([shopId, locationId, productId])
  @@index([shopId, locationName, productId])
}

enum JobType {
  FAST_FULL_SYNC
  FAST_DELTA_REFRESH

}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}