// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  FAST_FULL_SYNC
  FAST_DELTA_REFRESH
  SNAPSHOT_RUN
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model ShopState {
  shopId         String   @id
  fastReady      Boolean  @default(false)
  fastLastSyncAt DateTime?
  fastRevision   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductLite {
  id          String   @id // Shopify Product GID (stable, no extra mapping needed)
  shopId      String
  title       String
  handle      String
  status      String
  vendor      String?
  productType String?
  tags        String[] @default([])
  hasImages   Boolean  @default(false)

  createdAtShopify   DateTime?
  updatedAtShopify   DateTime?
  publishedAtShopify DateTime?

  // for sorting/paging in UI:
  updatedAt DateTime @default(now()) @updatedAt

  @@index([shopId, updatedAtShopify(sort: Desc)])
  @@index([shopId, title])
  @@unique([shopId, id])
}

model VariantRollup {
  // One row per product. Keep it tiny and indexed.
  shopId    String
  productId String

  variantCount          Int     @default(0)
  totalInventory        Int     @default(0)
  minPrice              Decimal? @db.Decimal(18, 6)
  maxPrice              Decimal? @db.Decimal(18, 6)
  hasOutOfStockVariant  Boolean @default(false)
  hasInStockVariant     Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt

  @@id([shopId, productId])
  @@index([shopId, totalInventory])
}

model JobLedger {
  id        String    @id @default(cuid())
  shopId    String
  type      JobType
  status    JobStatus @default(PENDING)

  // BullMQ job id, if applicable
  queueJobId String?

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, type, status])
  @@index([shopId, createdAt])
}
