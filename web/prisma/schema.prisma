// FILE: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 1. FAST PLANE (Metadata & Filtering)
// ---------------------------------------------------------------------------

/// Lean per-product metadata.
/// Optimized for: Lists, Grids, Filtering, and Pagination.
/// STRICT RULE: No HTML, no heavy text blobs, no aggregate counts (use Rollup).
model ProductLite {
  shopId             String
  productId          String

  // -- Identifiers & Handles --
  title              String
  handle             String
  status             String   // active, draft, archived
  vendor             String?
  productType        String?  @map("product_type")
  templateSuffix     String?  @map("template_suffix")
  category           String?  // for product.category filter

  // Option names for filters product.option1Name / 2 / 3
  option1Name        String?
  option2Name        String?
  option3Name        String?

  // -- Timestamps (Shopify Source) --
  createdAtShopify   DateTime  @map("created_at_shopify")
  updatedAtShopify   DateTime  @map("updated_at_shopify")
  publishedAtShopify DateTime? @map("published_at_shopify")
  
  // -- App-Side Timestamps --
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // -- Flags --
  hasImages          Boolean   @default(false)
  isSearchable       Boolean   @default(true)  @map("is_searchable")
  visibleOnlineStore Boolean   @default(true)  @map("visible_online_store")
  visiblePos         Boolean   @default(false) @map("visible_pos")

  // -- Tags (Postgres Native Array) --
  // Registry: "product.tag" uses array_overlap
  tags               String[]  @default([])

  // FTS vector for title (for product.title FTS filter)
  titleSearchVector  Unsupported("tsvector")?

  // -- Internal --
  id                 BigInt    @id @default(autoincrement())

  // -- Relations --
  // 1:1 Split for Memory Safety
  content            ProductContent? 

  // 1:1 Split for SSOT Aggregates
  rollup             VariantRollup?

  // 1:N Relations
  collections        ProductCollection[]
  inventoryByLoc     ProductInventoryLocation[]
  optionValues       ProductOptionValue[]
  variants           VariantLite[]

  // -- Constraints --
  @@unique([shopId, productId], map: "product_lite_shop_product_uniq")

  // -- Indexes for Registry Filters --
  @@index([shopId, id])
  @@index([shopId, status, id])
  @@index([shopId, vendor, id])
  @@index([shopId, productType, id])
  @@index([shopId, handle])
  @@index([shopId, title])
  @@index([shopId, category, id])

  // Tag Filter (GIN Index) - CRITICAL for "Tag IN [...]"
  @@index([tags], type: Gin)
}

/// Heavy content separated to prevent memory blow-ups.
/// Fetched ONLY when editing or specifically requested.
model ProductContent {
  shopId         String
  productId      String
  
  // Registry: "product.description"
  description    String?  @db.Text
  
  // Registry: "product.seoTitle"
  seoTitle       String?
  
  // Registry: "product.seoDescription"
  seoDescription String?

  // -- Search Vectors for FTS filters --
  descriptionSearchVector    Unsupported("tsvector")?
  seoTitleSearchVector       Unsupported("tsvector")?
  seoDescriptionSearchVector Unsupported("tsvector")?

  product        ProductLite @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)

  @@id([shopId, productId])
}

/// The Single Source of Truth (SSOT) for all numeric aggregates.
/// Prevents drift between "Product Cache" and "Variant Reality".
model VariantRollup {
  shopId             String
  productId          String

  id                 BigInt   @id @default(autoincrement())
  
  // Registry: "product.inventoryQuantity" maps here
  totalInventory     Int      @map("total_inventory")
  
  // Registry: "product.variantCount" maps here
  variantCount       Int      @map("variant_count")

  // Price Ranges
  minPrice           Decimal? @map("min_price")
  maxPrice           Decimal? @map("max_price")
  
  // Aggregated Booleans
  allContinueSelling Boolean  @default(false) @map("all_continue_selling")
  allTaxable         Boolean  @default(false) @map("all_taxable")
  allTrackQuantity   Boolean  @default(false) @map("all_track_quantity")
  hasPhysical        Boolean  @default(false) @map("has_physical")

  // Extended Aggregates (Optional but useful for sorting)
  minMargin          Decimal? @map("min_margin")
  maxMargin          Decimal? @map("max_margin")

  product            ProductLite @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)

  @@unique([shopId, productId])

  // -- Indexes for Numeric Range Filters --
  @@index([shopId, totalInventory, id])
  @@index([shopId, variantCount, id])
  @@index([shopId, minPrice, id])
  @@index([shopId, maxPrice, id])
}

/// Lean per-variant metadata.
model VariantLite {
  id               BigInt   @id @default(autoincrement())
  shopId           String
  variantId        String
  productId        String

  // -- Core Fields --
  title            String?
  sku              String?
  barcode          String?
  
  // -- Pricing --
  price            Decimal
  compareAtPrice   Decimal?
  cost             Decimal?
  profitMargin     Decimal? @map("profit_margin") // for variant.profitMargin

  // -- Inventory & Shipping --
  // Registry: "variant.inventoryQuantity" maps to inventoryQty
  inventoryQty     Int
  inventoryPolicy  String?  // deny, continue
  
  trackQuantity    Boolean?
  taxable          Boolean?
  requiresShipping Boolean? @default(false) // for variant.physicalProduct
  
  // Registry: "variant.weight" maps to weightGrams
  weightGrams      Int?
  weightUnit       String?  // g, kg, oz, lb

  // -- Options --
  option1Value     String?
  option2Value     String?
  option3Value     String?
  
  // -- Customs --
  countryOfOrigin  String?
  hsTariffCode     String?

  product          ProductLite               @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)
  inventoryByLoc   VariantInventoryLocation[]

  @@unique([shopId, variantId])
  
  // -- Indexes for Registry Filters --
  @@index([shopId, productId, id])

  // String Search
  @@index([shopId, sku])
  @@index([shopId, barcode])
  
  // Range Filters (Critical for Bulk Editor)
  @@index([shopId, price])
  @@index([shopId, inventoryQty])
  @@index([shopId, weightGrams])
  @@index([shopId, profitMargin])
  @@index([shopId, requiresShipping])
}

// ---------------------------------------------------------------------------
// 2. AUXILIARY RELATIONS
// ---------------------------------------------------------------------------

/// Product ↔ Collection mapping (Many-to-Many)
/// Registry: "product.collection" uses relation_some here
model ProductCollection {
  id               BigInt      @id @default(autoincrement())
  shopId           String
  productId        String
  collectionId     String
  
  collectionTitle  String?     @map("collection_title")
  collectionHandle String?     @map("collection_handle")

  product          ProductLite @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)

  @@unique([shopId, productId, collectionId])
  
  // Index for "Product has Collection X"
  @@index([shopId, collectionId, productId])
  
  // Index for "Collection Title contains 'Summer'"
  @@index([shopId, collectionTitle, productId])
}

/// Normalized option values (Optional - useful for "Option Value IN [...]")
model ProductOptionValue {
  id          BigInt      @id @default(autoincrement())
  shopId      String
  productId   String
  optionIndex Int
  value       String

  product     ProductLite @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)

  @@unique([shopId, productId, optionIndex, value])
  @@index([shopId, optionIndex, value, productId])
}

/// Per-product, per-location availability
model ProductInventoryLocation {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  productId     String
  locationId    String
  
  hasInventory  Boolean     @default(false)
  totalQuantity Int?

  product       ProductLite @relation(fields: [shopId, productId], references: [shopId, productId], onDelete: Cascade)

  @@unique([shopId, productId, locationId])
  @@index([shopId, locationId, productId])
}

/// Registry: "variant.inventoryLocation"
model VariantInventoryLocation {
  id           BigInt      @id @default(autoincrement())
  shopId       String
  variantId    String
  locationId   String
  locationName String?
  
  available    Int?

  variant      VariantLite @relation(fields: [shopId, variantId], references: [shopId, variantId], onDelete: Cascade)

  @@unique([shopId, variantId, locationId])
  @@index([shopId, locationName])
}

// ---------------------------------------------------------------------------
// 3. SNAPSHOT SYSTEM (Bulk Operation History)
// ---------------------------------------------------------------------------

enum SnapshotRunState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model SnapshotRun {
  id            BigInt           @id @default(autoincrement())
  shopId        String
  planHash      String
  filterSummary String?
  state         SnapshotRunState @default(QUEUED)
  
  progress      Int              @default(0)
  total         Int              @default(0)
  errorMessage  String?
  createdAt     DateTime         @default(now())

  shop          Shop             @relation(fields: [shopId], references: [id])
  products      SnapshotProduct[]
  events        SnapshotRunEvent[]

  @@unique([shopId, planHash])
  @@index([shopId, state, createdAt])
}

/// Represents membership in a bulk operation.
/// Very lean; joins to ProductLite/Content for actual data.
model SnapshotProduct {
  id                     BigInt      @id @default(autoincrement())
  shopId                 String
  snapshotRunId          BigInt
  productId              BigInt      // Refers to ProductLite.id (BigInt)
  
  // Registry: "product.searchEngineVisibility" (Snapshot Plane)
  searchEngineVisibility String?     // Visible/Hidden

  sortKey                DateTime

  run                    SnapshotRun @relation(fields: [snapshotRunId], references: [id], onDelete: Cascade)

  @@index([shopId, snapshotRunId, sortKey])
}

model SnapshotRunEvent {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  snapshotRunId BigInt
  kind          String
  message       String
  createdAt     DateTime    @default(now())

  run           SnapshotRun @relation(fields: [snapshotRunId], references: [id], onDelete: Cascade)

  @@index([shopId, snapshotRunId, createdAt])
}

// ---------------------------------------------------------------------------
// 4. TENANCY & JOBS
// ---------------------------------------------------------------------------

model Shop {
  id               String        @id // shopDomain
  shopDomain       String        @unique
  accessToken      String?
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Sync Status
  fastReady        Boolean       @default(false)
  fastRevision     Int           @default(0)
  fastLastSyncAt   DateTime?
  fastSyncEnqueued Boolean       @default(false)

  snapshotRuns     SnapshotRun[]
  bulkEditJobs     BulkEditJob[]
}

model BulkEditJob {
  id           String    @id @default(cuid())
  shopId       String
  planHash     String
  action       Json
  state        String    // QUEUED | RUNNING | SUCCEEDED | FAILED
  
  total        Int       @default(0)
  processed    Int       @default(0)
  failed       Int       @default(0)
  errorMessage String?

  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  shop         Shop      @relation(fields: [shopId], references: [id])

  @@index([shopId, planHash])
  @@index([shopId, state, createdAt])
}
