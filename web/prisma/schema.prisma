// FILE: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// FAST PLANE
// ---------------------------------------------------------------------------

/// Lean per-product FAST plane row.
/// One row per (shopId, productId)
model ProductLite {
  shopId             String
  title              String
  handle             String
  status             String
  vendor             String?
  hasImages          Boolean                    @default(false)
  category           String?
  createdAt          DateTime                   @default(now())
  createdAtShopify   DateTime                   @map("created_at_shopify")
  description        String?
  isSearchable       Boolean                    @default(true) @map("is_searchable")
  maxPrice           Decimal?                   @map("max_price")
  minPrice           Decimal?                   @map("min_price")
  option1Name        String?                    @map("option1_name")
  option2Name        String?                    @map("option2_name")
  option3Name        String?                    @map("option3_name")
  productId          String
  productType        String?                    @map("product_type")
  publishedAtShopify DateTime?                  @map("published_at_shopify")
  tags               String[]                   @default([])
  templateSuffix     String?                    @map("template_suffix")
  totalInventory     Int?                       @map("total_inventory")
  updatedAt          DateTime                   @updatedAt
  updatedAtShopify   DateTime                   @map("updated_at_shopify")
  variantCount       Int?                       @map("variant_count")
  visibleOnlineStore Boolean                    @default(true) @map("visible_online_store")
  visiblePos         Boolean                    @default(false) @map("visible_pos")

  id                 BigInt                     @id @default(autoincrement())

  collections        ProductCollection[]
  inventoryByLoc     ProductInventoryLocation[]
  optionValues       ProductOptionValue[]
  tagsJoin           ProductTag[]
  variants           VariantLite[]
  variantRollup      VariantRollup?

  @@unique([shopId, productId], map: "product_lite_shop_product_uniq")

  // Core access patterns
  @@index([shopId, id])
  @@index([shopId, status, id])
  @@index([shopId, vendor, id])
  @@index([shopId, productType, id])
  @@index([shopId, createdAtShopify, id])
  @@index([shopId, updatedAtShopify, id])
  @@index([shopId, publishedAtShopify, id])
  @@index([shopId, handle])
  @@index([shopId, title])

  // FAST tag filters (array GIN)
  @@index([tags], type: Gin)
}

/// Rollups per product for variant stats (FAST plane)
model VariantRollup {
  shopId                 String
  productId              String

  id                     BigInt      @id @default(autoincrement())
  maxPrice               Decimal?    @map("max_price")
  minPrice               Decimal?    @map("min_price")
  totalInventory         Int         @map("total_inventory")
  variantCount           Int         @map("variant_count")

  allContinueSelling     Boolean     @default(false) @map("all_continue_selling")
  allTaxable             Boolean     @default(false) @map("all_taxable")
  allTrackQuantity       Boolean     @default(false) @map("all_track_quantity")
  anyContinueSelling     Boolean     @default(false) @map("any_continue_selling")
  anyTaxable             Boolean     @default(false) @map("any_taxable")
  anyTrackQuantity       Boolean     @default(false) @map("any_track_quantity")
  hasPhysical            Boolean     @default(false) @map("has_physical")

  maxCompareAtPrice      Decimal?    @map("max_compare_at_price")
  maxCost                Decimal?    @map("max_cost")
  maxInventoryPerVariant Int?        @map("max_inventory_per_variant")
  maxMargin              Decimal?    @map("max_margin")
  maxWeightGrams         Int?        @map("max_weight_grams")
  minCompareAtPrice      Decimal?    @map("min_compare_at_price")
  minCost                Decimal?    @map("min_cost")
  minInventoryPerVariant Int?        @map("min_inventory_per_variant")
  minMargin              Decimal?    @map("min_margin")
  minWeightGrams         Int?        @map("min_weight_grams")

  product                ProductLite @relation(fields: [shopId, productId], references: [shopId, productId])

  @@unique([shopId, productId])

  // Numeric filters on rollups
  @@index([shopId, totalInventory, id])
  @@index([shopId, minPrice, id])
  @@index([shopId, maxPrice, id])
  @@index([shopId, variantCount, id])
  @@index([shopId, minMargin, id])
  @@index([shopId, maxMargin, id])
  @@index([shopId, minWeightGrams, id])
  @@index([shopId, maxWeightGrams, id])
}

/// Optional normalized tags table (classic join)
model ProductTag {
  shopId    String
  productId String
  tag       String

  id        BigInt      @id @default(autoincrement())
  product   ProductLite @relation(fields: [shopId, productId], references: [shopId, productId])

  @@unique([shopId, productId, tag])
  @@index([shopId, tag, productId])
}

/// Product ↔ Collection mapping
model ProductCollection {
  shopId           String
  productId        String
  collectionId     String
  collectionHandle String?     @map("collection_handle")
  collectionTitle  String?     @map("collection_title")

  id               BigInt      @id @default(autoincrement())
  product          ProductLite @relation(fields: [shopId, productId], references: [shopId, productId])

  @@unique([shopId, productId, collectionId])
  @@index([shopId, collectionId, productId])
}

/// Lean per-variant FAST table
model VariantLite {
  id              BigInt      @id @default(autoincrement())
  shopId          String
  variantId       String
  productId       String
  sku             String?
  barcode         String?
  price           Decimal
  compareAtPrice  Decimal?
  cost            Decimal?
  taxable         Boolean?
  trackQuantity   Boolean?
  inventoryQty    Int
  inventoryPolicy String?
  weightGrams     Int?
  weightUnit      String?
  option1Value    String?
  option2Value    String?
  option3Value    String?
  title           String?
  countryOfOrigin String?
  hsTariffCode    String?

  product         ProductLite @relation(fields: [shopId, productId], references: [shopId, productId])

  @@unique([shopId, variantId])
  @@index([shopId, productId, id])
  @@index([shopId, sku])
  @@index([shopId, barcode])
  @@index([shopId, price])
}

/// Normalized option values per product
model ProductOptionValue {
  id          BigInt      @id @default(autoincrement())
  shopId      String
  productId   String
  optionIndex Int
  value       String

  product     ProductLite @relation(fields: [shopId, productId], references: [shopId, productId])

  @@unique([shopId, productId, optionIndex, value])
  @@index([shopId, optionIndex, value, productId])
}

/// Per-product, per-location availability
model ProductInventoryLocation {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  productId     String
  locationId    String
  hasInventory  Boolean     @default(false)
  totalQuantity Int?

  product       ProductLite @relation(fields: [shopId, productId], references: [shopId, productId])

  @@unique([shopId, productId, locationId])
  @@index([shopId, locationId, productId])
}

//
// SNAPSHOT SYSTEM (membership snapshot used by index.js)
// ---------------------------------------------------------------------------

enum SnapshotRunState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model SnapshotRun {
  id            BigInt           @id @default(autoincrement())
  shopId        String
  planHash      String
  filterSummary String?

  state         SnapshotRunState @default(QUEUED)

  progress      Int              @default(0)
  total         Int              @default(0)
  errorMessage  String?

  createdAt     DateTime         @default(now())

  shop          Shop             @relation(fields: [shopId], references: [id])
  products      SnapshotProduct[]
  events        SnapshotRunEvent[]

  @@unique([shopId, planHash])   // <<< IMPORTANT
  @@index([shopId, state, createdAt])
}


model SnapshotProduct {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  snapshotRunId BigInt
  productId     BigInt
  sortKey       DateTime

  run           SnapshotRun @relation(fields: [snapshotRunId], references: [id])

  @@index([shopId, snapshotRunId, sortKey])
}

model SnapshotRunEvent {
  id            BigInt      @id @default(autoincrement())
  shopId        String
  snapshotRunId BigInt
  kind          String
  message       String
  createdAt     DateTime    @default(now())

  run           SnapshotRun @relation(fields: [snapshotRunId], references: [id])

  @@index([shopId, snapshotRunId, createdAt])
}

//
// BULK EDIT JOBS
// ---------------------------------------------------------------------------

model BulkEditJob {
  id           String   @id @default(cuid())
  shopId       String
  planHash     String

  action       Json
  state        String   // QUEUED | RUNNING | SUCCEEDED | FAILED

  total        Int      @default(0)
  processed    Int      @default(0)
  failed       Int      @default(0)
  errorMessage String?

  createdAt    DateTime @default(now())
  completedAt  DateTime?

  shop         Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, planHash])
  @@index([shopId, state, createdAt])
}

//
// SHOP (TENANT ROOT)
// ---------------------------------------------------------------------------

model Shop {
  /// Internal ID for this shop (we use the shopDomain as id)
  id           String        @id

  /// Shopify domain like "demo-zen-store.myshopify.com"
  shopDomain   String        @unique

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  /// Optional access token (for API calls)
  accessToken  String?

  /// FAST plane sync status
  fastReady        Boolean   @default(false)
  fastRevision     Int       @default(0)
  fastLastSyncAt   DateTime?
  fastSyncEnqueued Boolean   @default(false)

  snapshotRuns SnapshotRun[]
  bulkEditJobs BulkEditJob[]
}
